NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_BOOTSTRAP_KEY=replace-with-a-different-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: set DATABASE_URL to use a managed/external PostgreSQL server instead.
# Optional: set PGLITE_DATA_DIR to move the local embedded database directory.
# Configure SMTP to enable password reset emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=PG Stay <no-reply@example.com>
# APP_BASE_URL=http://localhost:5173
