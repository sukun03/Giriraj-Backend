NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OWNER_CONTROL_KEY=replace-with-a-private-random-secret-at-least-32-characters-long
# Required on Vercel for the scheduled password-reset-token cleanup.
# CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vercel/production requires a managed PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Optional for local development: move the embedded database directory.
# PGLITE_DATA_DIR=data/postgres
# Configure SMTP to enable password reset emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=PG Stay <no-reply@example.com>
# APP_BASE_URL=http://localhost:5173
